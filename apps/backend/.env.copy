MEDUSA_ADMIN_ONBOARDING_TYPE=default
STORE_CORS=https://cavagna.shop,https://www.cavagna.shop
ADMIN_CORS=https://admin.cavagna.shop
AUTH_CORS=https://cavagna.shop,https://www.cavagna.shop,https://admin.cavagna.shop
REDIS_URL=redis://default:PASSWORD@HOST:PORT
JWT_SECRET=change-me
COOKIE_SECRET=change-me
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=CAVAGNA <contact@cavagna.shop>
STRIPE_API_KEY=sk_live_xxxxxxxx

S3_FILE_URL=https://your-bucket.s3.your-region.amazonaws.com
S3_ACCESS_KEY_ID=xxxxxxxx
S3_SECRET_ACCESS_KEY=xxxxxxxx
S3_BUCKET=your-bucket
S3_ENDPOINT=https://s3.your-region.amazonaws.com
S3_REGION=your-region

META_PIXEL_ID=xx
META_ACCESS_TOKEN=xx
TIKTOK_PIXEL_ID=xx
TIKTOK_ACCESS_TOKEN=xx
# --- CJdropshipping (synchro des commandes) ---
# Clé API : CJ -> Apps -> API -> Add API (format: CJUserNum@api@xxxx)
# Tant que CJ_API_KEY est vide, la synchro est inactive (aucune commande envoyée à CJ).
CJ_API_KEY=
# Entrepôt d'expédition CJ (CN par défaut, ou un entrepôt UE si tu en utilises un)
CJ_FROM_COUNTRY_CODE=CN
# Mode logistique CJ (ex: "CJPacket Ordinary"). À ajuster selon la destination.
CJ_LOGISTIC_NAME=CJPacket Ordinary
# 3 = crée la commande chez CJ sans payer (tu valides/payes dans CJ) ; 2 = paie depuis la balance CJ
CJ_PAY_TYPE=3
